[Unit]
Description=TripPilot FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trippilot
Group=trippilot
WorkingDirectory=/opt/trippilot/backend
Environment="PATH=/opt/trippilot/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="HOME=/var/lib/trippilot"
ExecStart=/opt/trippilot/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/trippilot

[Install]
WantedBy=multi-user.target
