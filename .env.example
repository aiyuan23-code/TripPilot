# LLM
LLM_PROVIDER=deepseek
LLM_MODEL_ID=your_model_id
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_STRUCTURED_OUTPUT_METHOD=json_mode

# AMap Web Service / MCP
AMAP_MAPS_API_KEY=your_amap_web_service_api_key
AMAP_MCP_COMMAND=uvx
AMAP_MCP_PACKAGE=amap-mcp-server

# Browser origins allowed to call FastAPI directly. With the recommended
# same-origin Nginx proxy this mainly documents the deployed public origin.
CORS_ORIGINS=http://47.108.74.69
